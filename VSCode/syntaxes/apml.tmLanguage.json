{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "APML",
  "scopeName": "source.apml",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#charlit" },
    { "include": "#block" },
    { "include": "#label" },
    { "include": "#namespace" },
    { "include": "#call" },
    { "include": "#bindcall" },
    { "include": "#number" },
    { "include": "#logic" },
    { "include": "#value" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#builtin" },
    { "include": "#foreignbody" },
    { "include": "#definition" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.apml",
      "match": "#.*$"
    },
    "string": {
      "name": "string.quoted.double.apml",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.apml", "match": "\\\\." }
      ]
    },
    "charlit": {
      "name": "constant.character.apml",
      "match": "\\\\[xu][0-9A-Fa-f]+(?:[,:][0-9A-Fa-f]+)*"
    },
    "block": {
      "comment": "a character block: a set of characters, never a regex",
      "name": "string.regexp.apml",
      "match": "<[^>\\n]*>"
    },
    "label": {
      "comment": "an AST-map label, spent by the compiler and never in the binary",
      "name": "variable.parameter.apml",
      "match": "'[A-Za-z0-9_]+'"
    },
    "namespace": {
      "match": "\\b(tex)(::)",
      "captures": {
        "1": { "name": "entity.name.namespace.apml" },
        "2": { "name": "keyword.operator.apml" }
      }
    },
    "call": {
      "comment": "a result function, or a semvar or scope call",
      "match": "(::)(order|oneof|icase|is|not|subkind|part|char_count|to_num|iter_steps|until|first|begin|end|clear)\\b",
      "captures": {
        "1": { "name": "keyword.operator.apml" },
        "2": { "name": "support.function.apml" }
      }
    },
    "bindcall": {
      "comment": "binding to a precedence table at the call site: bp::-expr",
      "match": "(::)(-)([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "keyword.operator.apml" },
        "2": { "name": "keyword.operator.apml" },
        "3": { "name": "support.function.apml" }
      }
    },
    "number": {
      "name": "constant.numeric.apml",
      "match": "\\b\\d+\\b"
    },
    "logic": {
      "name": "keyword.operator.word.apml",
      "match": "\\b(AND|OR|NOT)\\b"
    },
    "value": {
      "name": "constant.language.apml",
      "match": "\\b(TRUE|FALSE)\\b"
    },
    "keyword": {
      "name": "keyword.control.apml",
      "match": "\\b(program|link|parser|config|feat|bindpow|foreign|node_id|alias|perm|if|node)\\b"
    },
    "type": {
      "name": "storage.type.apml",
      "match": "\\b(texvar|numvar|semvar|scope)\\b"
    },
    "builtin": {
      "name": "support.function.builtin.apml",
      "match": "\\b(spc|nl|eol|eof|char|error)\\b"
    },
    "foreignbody": {
      "comment": "`indent = _;` -- this action's body is C the host supplies",
      "name": "support.class.apml",
      "match": "(?<![A-Za-z0-9_])_(?![A-Za-z0-9_])"
    },
    "definition": {
      "comment": "the name being defined, so a rule is findable by eye",
      "match": "^\\s*([a-zA-Z_]\\w*)\\s*(:=|=)(?!=)",
      "captures": {
        "1": { "name": "entity.name.function.apml" },
        "2": { "name": "keyword.operator.apml" }
      }
    },
    "operator": {
      "comment": "`.` is the inbetween skip, not punctuation",
      "name": "keyword.operator.apml",
      "match": ":=|->|=>|::|[=|/+*?:.\\-!]"
    }
  }
}
